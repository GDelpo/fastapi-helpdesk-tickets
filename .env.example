# ============================================================================
# Tickets Service — Variables de entorno
# ============================================================================
# Copiar a .env y completar con valores reales

# App
DEBUG=False
LOG_FORMAT=json
SERVICE_NAME=Mesa de Ayuda

# Branding
COMPANY_NAME=Example Corp
COMPANY_LEGAL_TAGLINE=Entidad de ejemplo
PORTAL_NAVBAR_TITLE=Example Corp
SUPPORT_EMAIL=admin@example.com
COMPANY_WEBSITE=https://www.example.com
COMPANY_LOGO_URL=https://www.example.com/logo.png
COMPANY_FAVICON_URL=https://www.example.com/favicon-32x32.png

# Base de datos PostgreSQL
DB_HOST=tickets_postgres
DB_PORT=5432
DB_NAME=tickets
DB_USER=tickets_user
DB_PASSWORD=your-postgres-password-change-me

# Identity Service
IDENTITY_SERVICE_URL=http://identity_api:8080/api/v1
IDENTITY_EXTERNAL_URL=http://192.0.2.10/identity/api/v1

# Mailsender Service
MAILSENDER_URL=http://mailsender_api:8081/api/v1/emails

# Portal — URL base para links en emails de notificación
PORTAL_BASE_URL=http://192.0.2.10/tickets/portal

# Cuenta de servicio en identity (role=service) para llamadas server-to-server
TICKETS_SERVICE_USER=tickets-service
TICKETS_SERVICE_PASSWORD=your-service-account-password
